# btran configuration (CLI options override these values)
BTRAN_MODEL=openai-codex/gpt-5.6-terra
BTRAN_TARGET_LANG=en
# Minimums: concurrency 1; retries 0; timeout 0 seconds (no timeout). No upper bounds.
BTRAN_CONCURRENCY=4
BTRAN_MAX_RETRIES=3
BTRAN_TIMEOUT=120
BTRAN_INTERMEDIATE_DIR=./intermediate
BTRAN_PI_BIN=pi
BTRAN_TITLE=Translated Book
BTRAN_AUTHOR=Unknown

# Optional pipeline controls. Omit BTRAN_MANIFEST_PATH to use
# INPUT_DIR/manifest.json; it is intentionally not resolved from this cwd.
# BTRAN_MANIFEST_PATH=./photos/manifest.json
BTRAN_EPUB_CHECK=false
BTRAN_EPUB_CHECK_PATH=epubcheck
BTRAN_GLOSSARY_BUDGET=100000
