# btran configuration (CLI options override these values)
# Default model: openai-codex/gpt-5.6-terra. Pi receives this as --model.
BTRAN_MODEL=openai-codex/gpt-5.6-terra
# Pi receives this as --thinking. Allowed: off, minimal, low, medium, high, xhigh, max.
BTRAN_REASONING_LEVEL=low
BTRAN_TARGET_LANG=en
# Concurrency: 1–32. Retries: 0–5. Timeout: 1–3600 seconds for terminology
# consolidation and EPUBCheck only; Pi extraction and translation have no deadline.
BTRAN_CONCURRENCY=4
BTRAN_MAX_RETRIES=3
BTRAN_TIMEOUT=120
# Workspace holds btran state. Pi sessions are stored at WORKSPACE/pi-sessions.
BTRAN_WORKSPACE=./.btran
BTRAN_INTERMEDIATE_DIR=./intermediate
BTRAN_PI_BIN=pi
BTRAN_TITLE=Translated Book
BTRAN_AUTHOR=Unknown

# Optional pipeline controls. Omit BTRAN_MANIFEST_PATH to use
# INPUT_DIR/manifest.json; it is intentionally not resolved from this cwd.
# BTRAN_MANIFEST_PATH=./photos/manifest.json
BTRAN_EPUB_CHECK=false
BTRAN_EPUB_CHECK_PATH=epubcheck
BTRAN_GLOSSARY_BUDGET=100000
